S3_BUCKET=lindaben-cms
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://127.0.0.1:3900/lindaben-cms

ADMIN_USERNAME=lindabenfoundation@neo
# sha256:<hex>. Generate with: node -e "console.log('sha256:'+require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" 'your-password'
ADMIN_PASSWORD_HASH=sha256:CHANGE_ME
SESSION_SECRET=replace-with-at-least-32-random-characters

SUPPORTED_LOCALES=en,es,fa,fr,ur,ko,ps,zh
DEFAULT_LOCALE=en

AWS_BEARER_TOKEN_BEDROCK=YOUR_ROTATED_BEDROCK_API_KEY
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
ALLOWED_IFRAME_HOSTS=www.youtube.com,youtube.com,player.vimeo.com
